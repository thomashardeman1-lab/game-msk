<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>De Digitale Vossenjacht • MSK Gent</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-serif { font-family: 'Playfair Display', serif; }
        .bg-canvas {
            background-color: #0f1612;
            background-image: radial-gradient(circle at 50% 20%, #1a2a20 0%, #0c120e 100%);
        }
        .gold-border {
            border: 1px solid rgba(217, 119, 6, 0.3);
        }
        .gold-glow:hover {
            box-shadow: 0 0 25px rgba(217, 119, 6, 0.25);
        }
    </style>
</head>
<body class="bg-canvas text-stone-200 min-h-screen flex flex-col justify-between selection:bg-amber-800 selection:text-white">

    <!-- Header -->
    <header class="w-full border-b border-amber-900/30 bg-[#121c17]/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <span class="text-amber-500 font-serif text-2xl font-bold tracking-wider">MSK</span>
                <span class="h-4 w-px bg-amber-900/50"></span>
                <span class="text-xs uppercase tracking-widest text-stone-400 font-medium">Museum voor Schone Kunsten Gent</span>
            </div>
            <div class="text-xs uppercase tracking-wider bg-amber-950/80 border border-amber-800/40 px-3 py-1.5 rounded-full text-amber-300">
                Interactieve Installatie
            </div>
        </div>
    </header>

    <!-- Hero / Startpagina Content -->
    <main class="flex-1 flex items-center justify-center p-6 md:p-12">
        <div class="max-w-4xl w-full grid md:grid-cols-12 gap-8 items-center">
            
            <!-- Linkerkolom: Sfeerbeeld / Kunstwerk -->
            <div class="md:col-span-5 relative group">
                <div class="absolute -inset-1 bg-gradient-to-r from-amber-600/30 to-amber-900/30 rounded-2xl blur-lg opacity-70 group-hover:opacity-100 transition duration-1000"></div>
                <div class="relative bg-stone-900 rounded-2xl overflow-hidden gold-border aspect-[3/4] shadow-2xl">
                    <img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=800&q=80" 
                         alt="Classic Still Life" 
                         class="w-full h-full object-cover object-center opacity-85 hover:scale-105 transition-transform duration-700">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent p-6 flex flex-col justify-end">
                        <span class="text-xs uppercase tracking-widest text-amber-400 font-semibold mb-1">Details uit de verzameling</span>
                        <p class="font-serif text-sm text-stone-300 italic">"Stilleven met uil en jachtbuit" — Peeter Boel</p>
                    </div>
                </div>
            </div>

            <!-- Rechterkolom: Introductie & Start CTA -->
            <div class="md:col-span-7 space-y-6 text-left">
                <div class="inline-flex items-center gap-2 bg-amber-950/50 border border-amber-800/30 px-3.5 py-1.5 rounded-full text-amber-300 text-xs font-semibold uppercase tracking-wider">
                    <span>🦊 🏹</span>
                    <span>Spel voor 2 Spelers</span>
                </div>

                <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-amber-100 leading-[1.15]">
                    De Digitale <br><span class="italic text-amber-400">Vossenjacht</span>
                </h1>

                <p class="text-stone-300 text-base md:text-lg leading-relaxed font-light">
                    Stap in de wereld van 17e-eeuwse jachttaferelen. Speur door de schilderijen van het MSK Gent, ontrafel de verborgen details en neem het tegen elkaar op.
                </p>

                <!-- Spelregels in het kort -->
                <div class="grid grid-cols-2 gap-4 py-2 border-y border-amber-900/30">
                    <div class="space-y-1">
                        <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Rol 1: De Vos</span>
                        <p class="text-xs text-stone-400">Spoor de details op en probeer uit handen te blijven van de jager.</p>
                    </div>
                    <div class="space-y-1">
                        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Rol 2: De Jager</span>
                        <p class="text-xs text-stone-400">Analyseer het schilderij en achterhaal de jachtsignalen het snelst.</p>
                    </div>
                </div>

                <!-- Actieknop -->
                <div class="pt-2">
                    <button onclick="alert('Het spel wordt geladen...')" class="w-full sm:w-auto bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-stone-950 font-bold px-8 py-4 rounded-xl shadow-xl transition-all transform hover:-translate-y-0.5 gold-glow text-lg flex items-center justify-center gap-3">
                        <span>Start de Jacht</span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                    </button>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="w-full border-t border-amber-900/20 py-6 text-center text-xs text-stone-500">
        <p>© MSK Gent • Ontwikkeld voor de interactieve museum-installatie</p>
    </footer>

</body>
</html>
